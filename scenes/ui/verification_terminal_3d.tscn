[sub_resource type="Shader" id="ScreenGlass"]
code = "shader_type canvas_item;
render_mode unshaded;

void fragment() {
	vec2 edge_distance = min(UV, vec2(1.0) - UV);
	float inset = 1.0 - smoothstep(0.0, 0.045, min(edge_distance.x, edge_distance.y));
	float corners = smoothstep(0.30, 0.71, length((UV - 0.5) * vec2(0.9, 1.1)));
	float scan = 0.018 * (1.0 - step(1.0, mod(FRAGCOORD.y, 3.0)));
	float reflection = pow(max(1.0 - UV.y - 0.30 * UV.x, 0.0), 10.0) * 0.11;
	float rim = (1.0 - smoothstep(0.0, 0.003, UV.y)) * 0.13;
	float shadow = inset * 0.38 + corners * 0.13 + scan;
	float sheen = reflection + rim;
	float opacity = shadow + sheen;
	COLOR = vec4(mix(vec3(0.025, 0.016, 0.01), vec3(0.82, 0.69, 0.51),
			sheen / max(opacity, 0.001)), opacity);
}
"


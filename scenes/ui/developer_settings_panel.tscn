[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/developer_settings_panel.gd" id="1_settings"]

[node name="DeveloperSettingsPanel" type="VBoxContainer"]
visible = false
size_flags_vertical = 3
theme_override_constants/separation = 10
script = ExtResource("1_settings")

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 42
text = "开发者模式"

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Rows" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Status" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3

[node name="Footer" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14
alignment = 2

[node name="Back" type="Button" parent="Footer"]
layout_mode = 2
text = "返回"

[node name="Quit" type="Button" parent="Footer"]
layout_mode = 2
text = "退出程序"

[node name="Primary" type="Button" parent="Footer"]
visible = false
layout_mode = 2

[node name="Cancel" type="Button" parent="Footer"]
visible = false
layout_mode = 2
text = "取消"

~ pickup_start
Passenger: TEST PICKUP
- TEST CONFIRM
    do mark_door_greeting_done()
    do status_hint("TEST CONFIRMED")
    Passenger: TEST READY
    => END
- TEST WAIT
    do mark_door_greeting_done()
    Passenger: TEST WAITING
    => END

~ onboard_start
Passenger: TEST ONBOARD
- TEST QUESTION A
    do status_hint("TEST RESPONSE A")
    Passenger: TEST ANSWER A
    => END
- TEST QUESTION B
    do status_hint("TEST RESPONSE B")
    Passenger: TEST ANSWER B
    => END

~ destination_900
do status_hint("TEST ARRIVAL 900")
Passenger: TEST COMPLETE 900
=> END

